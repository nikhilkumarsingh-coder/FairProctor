# Copy to .env (never commit .env). Local development needs none of these: it uses SQLite.

# PostgreSQL (Neon / Render). Leave empty locally to use backend/data/fairproctor.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign JWTs (python -c "import secrets; print(secrets.token_urlsafe(48))")
FP_JWT_SECRET=change-me

# First admin, created on start-up if it does not exist yet
FP_ADMIN_EMAIL=admin@example.com
FP_ADMIN_PASSWORD=change-me-too

# The deployed frontend, comma-separated (for CORS)
FP_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Optional
RETENTION_DAYS=90
FP_TOKEN_HOURS=12

# Coding tests: how many programs may run at the same time (each candidate runs one at a time)
FP_RUNNER_SLOTS=2

# Demo logins on the login page ("Try the demo"): 1 = on (e.g. the hackathon deployment), 0 = off.
# Unset: on only with the local SQLite database, never on PostgreSQL.
FP_DEMO=0
